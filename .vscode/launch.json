{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug ZPG",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/ZPG",  // Nahraďte jménem vaší aplikace (např. zpg_app)
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }@
      ],
      "preLaunchTask": "CMake Build Debug",  // Spustí build před debugem
      "miDebuggerPath": "/usr/bin/gdb"  // Cesta k GDB na Ubuntu
    }
  ]
}